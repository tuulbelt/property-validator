{"version": 2, "width": 80, "height": 24, "timestamp": 1767536700, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Property Validator / propval - Tuulbelt"}
[0.004347, "o", "# Property Validator Demo\r\n"]
[1.006332, "o", "\r\n# 1. Install globally for easy access\r\n"]
[1.507868, "o", "$ npm link\r\n"]
[2.509546, "o", "\r\n# 2. Validate valid user data\r\n"]
[3.011222, "o", "$ cat demo-files/valid-user.json\r\n"]
[3.012401, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[4.013895, "o", "\r\n$ propval \"$(cat demo-files/valid-user.json)\"\r\n"]
[5.092848, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[7.113975, "o", "\r\n# 3. Validate invalid data (clear error message)\r\n"]
[7.615567, "o", "$ cat demo-files/invalid-user.json\r\n"]
[7.616741, "o", "{\r\n  \"name\": \"Bob\",\r\n  \"age\": \"thirty\",\r\n  \"email\": \"bob@example.com\"\r\n}\r\n"]
[8.618211, "o", "\r\n$ propval \"$(cat demo-files/invalid-user.json)\"\r\n"]
[9.64, "o", "Validation error: Invalid property 'age': Expected number, got string\r\n"]
[11.659738, "o", "\r\n# 4. Validate API response data\r\n"]
[12.16129, "o", "$ echo '{\"name\":\"Charlie\",\"age\":25,\"email\":\"charlie@example.com\"}' | propval\r\n"]
[13.187114, "o", "Error: No input provided\r\n"]
[13.187325, "o", "Usage: propval [options] <json-data>\r\n"]
