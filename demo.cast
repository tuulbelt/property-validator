{"version": 2, "width": 80, "height": 24, "timestamp": 1767596941, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Property Validator / propval - Tuulbelt"}
[0.004697, "o", "# Property Validator Demo\r\n"]
[1.007236, "o", "\r\n# 1. Install globally for easy access\r\n"]
[1.508892, "o", "$ npm link\r\n"]
[2.510415, "o", "\r\n# 2. Validate valid user data\r\n"]
[3.011939, "o", "$ cat demo-files/valid-user.json\r\n"]
[3.013212, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[4.014701, "o", "\r\n$ propval \"$(cat demo-files/valid-user.json)\"\r\n"]
[5.117305, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[7.139434, "o", "\r\n# 3. Validate invalid data (clear error message)\r\n"]
[7.641224, "o", "$ cat demo-files/invalid-user.json\r\n"]
[7.642338, "o", "{\r\n  \"name\": \"Bob\",\r\n  \"age\": \"thirty\",\r\n  \"email\": \"bob@example.com\"\r\n}\r\n"]
[8.643918, "o", "\r\n$ propval \"$(cat demo-files/invalid-user.json)\"\r\n"]
[9.681938, "o", "Validation error: Invalid property 'age': Expected number, got string\r\n"]
[11.70361, "o", "\r\n# 4. Validate API response data\r\n"]
[12.205223, "o", "$ echo '{\"name\":\"Charlie\",\"age\":25,\"email\":\"charlie@example.com\"}' | propval\r\n"]
[13.23151, "o", "Error: No input provided\r\n"]
[13.231715, "o", "Usage: propval [options] <json-data>\r\n"]
[13.231779, "o", "Try: propval --help\r\n"]
