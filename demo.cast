{"version": 2, "width": 80, "height": 24, "timestamp": 1767475698, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Property Validator / propval - Tuulbelt"}
[0.004515, "o", "# Property Validator Demo\r\n"]
[1.00671, "o", "\r\n# 1. Install globally for easy access\r\n"]
[1.50839, "o", "$ npm link\r\n"]
[2.510061, "o", "\r\n# 2. Validate valid user data\r\n"]
[3.01175, "o", "$ cat demo-files/valid-user.json\r\n"]
[3.013017, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[4.014525, "o", "\r\n$ propval \"$(cat demo-files/valid-user.json)\"\r\n"]
[5.106249, "o", "{"]
[5.106405, "o", "\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[7.128208, "o", "\r\n# 3. Validate invalid data (clear error message)\r\n"]
[7.629822, "o", "$ cat demo-files/invalid-user.json\r\n"]
[7.630987, "o", "{\r\n  \"name\": \"Bob\",\r\n  \"age\": \"thirty\",\r\n  \"email\": \"bob@example.com\"\r\n}\r\n"]
[8.63259, "o", "\r\n$ propval \"$(cat demo-files/invalid-user.json)\"\r\n"]
[9.654648, "o", "Validation error: Invalid property 'age': Expected number, got string\r\n"]
[11.67464, "o", "\r\n# 4. Validate API response data\r\n"]
[12.176359, "o", "$ echo '{\"name\":\"Charlie\",\"age\":25,\"email\":\"charlie@example.com\"}' | propval\r\n"]
[13.204749, "o", "Error: No input provided\r\n"]
[13.204929, "o", "Usage: propval [options] <json-data>\r\n"]
