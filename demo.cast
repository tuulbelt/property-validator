{"version": 2, "width": 80, "height": 24, "timestamp": 1767571017, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Property Validator / propval - Tuulbelt"}
[0.004966, "o", "# Property Validator Demo\r\n"]
[1.00705, "o", "\r\n# 1. Install globally for easy access\r\n"]
[1.508751, "o", "$ npm link\r\n"]
[2.510259, "o", "\r\n# 2. Validate valid user data\r\n"]
[3.011838, "o", "$ cat demo-files/valid-user.json\r\n"]
[3.012945, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[4.014365, "o", "\r\n$ propval \"$(cat demo-files/valid-user.json)\"\r\n"]
[5.180147, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[7.201129, "o", "\r\n# 3. Validate invalid data (clear error message)\r\n"]
[7.702747, "o", "$ cat demo-files/invalid-user.json\r\n"]
[7.703764, "o", "{\r\n  \"name\": \"Bob\",\r\n  \"age\": \"thirty\",\r\n  \"email\": \"bob@example.com\"\r\n}\r\n"]
[8.705212, "o", "\r\n$ propval \"$(cat demo-files/invalid-user.json)\"\r\n"]
[9.749876, "o", "Validation error: Invalid property 'age': Expected number, got string\r\n"]
[11.770645, "o", "\r\n# 4. Validate API response data\r\n"]
[12.272281, "o", "$ echo '{\"name\":\"Charlie\",\"age\":25,\"email\":\"charlie@example.com\"}' | propval\r\n"]
[13.315714, "o", "Error: No input provided\r\n"]
[13.315914, "o", "Usage: propval [options] <json-data>\r\n"]
