{"version": 2, "width": 80, "height": 24, "timestamp": 1767641872, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Property Validator / propval - Tuulbelt"}
[0.004213, "o", "# Property Validator Demo\r\n"]
[1.00653, "o", "\r\n# 1. Install globally for easy access\r\n"]
[1.508081, "o", "$ npm link\r\n"]
[2.509696, "o", "\r\n# 2. Validate valid user data\r\n"]
[3.011225, "o", "$ cat demo-files/valid-user.json\r\n"]
[3.012473, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[4.013904, "o", "\r\n$ propval \"$(cat demo-files/valid-user.json)\"\r\n"]
[5.10145, "o", "{\r\n  \"name\": \"Alice\",\r\n  \"age\": 30,\r\n  \"email\": \"alice@example.com\"\r\n}\r\n"]
[7.122402, "o", "\r\n# 3. Validate invalid data (clear error message)\r\n"]
[7.623932, "o", "$ cat demo-files/invalid-user.json\r\n"]
[7.6251, "o", "{\r\n  \"name\": \"Bob\",\r\n  \"age\": \"thirty\",\r\n  \"email\": \"bob@example.com\"\r\n}\r\n"]
[8.626514, "o", "\r\n$ propval \"$(cat demo-files/invalid-user.json)\"\r\n"]
[9.66231, "o", "Validation error: Invalid property 'age': Expected number, got string\r\n"]
[11.682479, "o", "\r\n# 4. Validate API response data\r\n"]
[12.183959, "o", "$ echo '{\"name\":\"Charlie\",\"age\":25,\"email\":\"charlie@example.com\"}' | propval\r\n"]
[13.213655, "o", "Error: No input provided\r\n"]
[13.213859, "o", "Usage: propval [options] <json-data>\r\n"]
[13.213929, "o", "Try: propval --help\r\n"]
