{
  "name": "property-validator-benchmarks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Performance benchmarks for property-validator",
  "scripts": {
    "bench": "node --import tsx internal/api-tiers.bench.ts",
    "bench:internal": "node --import tsx internal/api-tiers.bench.ts",
    "bench:external": "node --import tsx external/zod.bench.ts && node --import tsx external/valibot.bench.ts",
    "bench:all": "npm run bench:internal && echo '\n--- External Comparison ---\n' && npm run bench:external",
    "bench:legacy": "node --import tsx index.bench.ts"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "tatami-ng": "^0.8.18",
    "tsx": "^4.19.2",
    "valibot": "^0.42.1",
    "zod": "^3.24.1"
  }
}
